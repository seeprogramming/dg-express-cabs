# EmailJS Configuration for D&G Express Cabs
# Sign up at https://www.emailjs.com/
# 1. Add an Email Service (e.g. Gmail) -> get Service ID
# 2. Create an Email Template -> get Template ID
# 3. Go to Account -> Public Key -> get Public Key

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Destination email where you want to receive booking inquiries
NEXT_PUBLIC_EMAILJS_TO_EMAIL=info@dgexpresscabs.com

# Optional: Separate template IDs if you want different templates for Cabs vs Packages
# NEXT_PUBLIC_EMAILJS_CAB_TEMPLATE_ID=your_cab_template_id
# NEXT_PUBLIC_EMAILJS_PACKAGE_TEMPLATE_ID=your_package_template_id
